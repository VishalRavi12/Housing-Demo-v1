# ---- Datasets: never commit (huge, and GPS + street imagery is location data) ----
# Keep the folders and their instruction files, ignore everything else inside them.
data/videos/*
data/images/*
data/parcels/*
!data/videos/PUT_GOPRO_VIDEOS_HERE.txt
!data/images/PUT_USER_PHOTOS_HERE.txt
!data/parcels/OPTIONAL_PARCELS_HERE.txt

# ---- Pipeline results: regenerated by running the pipeline ----
outputs/

# ---- Media / archives anywhere in the repo (safety net) ----
*.mp4
*.MP4
*.mov
*.MOV
*.lrv
*.LRV
*.thm
*.THM
*.360
*.zip
*.7z
*.rar
*.db
*.sqlite
*.geojson

# ---- Model weights / caches ----
*.safetensors
*.bin
*.pt
*.pth
*.onnx
.cache/

# ---- Python / editor / OS ----
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
